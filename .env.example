# API Configuration
# This is the ONLY place the backend origin is configured. It is baked in at
# build time and is deliberately not overridable from the browser — every API
# call carries the admin's bearer token, so a runtime-settable origin would be
# a token-exfiltration hole.
NEXT_PUBLIC_API_URL=https://swat-delivery-api.onrender.com

# (NextAuth variables removed — next-auth was never used and has been dropped
# from package.json. Auth is the backend's own JWT login.)
